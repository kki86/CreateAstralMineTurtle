local SIZE = 4

-- Move forward while digging
local function forward()
    turtle.dig()
    while not turtle.forward() do
        turtle.dig()
    end
end

-- Move up while digging
local function up()
    turtle.digUp()
    while not turtle.up() do
        turtle.digUp()
    end
end

-- Turn around
local function turnAround()
    turtle.turnRight()
    turtle.turnRight()
end

-- Mine one 4x4 layer
local function mineLayer()

    for row = 1, SIZE do

        -- Mine across the row
        for col = 1, SIZE - 1 do
            forward()
        end

        -- Move to next row
        if row < SIZE then

            if row % 2 == 1 then
                turtle.turnRight()
                forward()
                turtle.turnLeft()
            else
                turtle.turnLeft()
                forward()
                turtle.turnRight()
            end

        end
    end
end

-- Mine 4 layers
for layer = 1, SIZE do

    mineLayer()

    if layer < SIZE then

        -- Return to the beginning of the layer
        turnAround()

        for i = 1, SIZE - 1 do
            forward()
        end

        turnAround()

        -- Move up
        up()
    end
end

print("Mining complete!")
